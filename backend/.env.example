# ---------------------------------------------------------------------------
# REVIVE AI — Environment Configuration
# ---------------------------------------------------------------------------

# Port (matches frontend default http://localhost:4000)
PORT=4000

# MongoDB Configuration (optional for simulator)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=revive_db

# AI Provider Configuration (Server-Side Only - Never exposed to frontend)
# Set your API key for OpenAI, Gemini, Groq, or any OpenAI-compatible LLM endpoint:
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
